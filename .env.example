# Copy to .env.production (or set in the deploy environment) and point at the real backend.
# VITE_API_URL is the backend ORIGIN only (no /api suffix); the app appends /api and /api/v1.
# If unset, the app falls back to http://localhost:8080, which is wrong for production.
VITE_API_URL=https://api.your-domain.example
